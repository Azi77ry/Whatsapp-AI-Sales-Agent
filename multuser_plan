## Proposed Changes

### 1. 🗄️ Database Schema Updates

#### [MODIFY] [schema.prisma](file:///c:/Users/Aziry Tech/Desktop/whatsapp-ai-sales-agent/prisma/schema.prisma)

Tutaongeza model mpya ya `Merchant` na kuhusisha models zote za bidhaa, oda, na mazungumzo na `Merchant`:

```prisma
model Merchant {
  id           Int      @id @default(autoincrement())
  businessName String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products        Product[]
  conversations   Conversation[]
  orders          Order[]
  specialRequests SpecialRequest[]

  @@map("merchants")
}

model Product {
  id          Int      @id @default(autoincrement())
  merchantId  Int      // Kiunganishi cha SaaS
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // models nyingine za Product zinabaki...
}

model Conversation {
  id            Int      @id @default(autoincrement())
  merchantId    Int      // Kiunganishi cha SaaS
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // models nyingine za Conversation zinabaki...
}

model Order {
  id             Int      @id @default(autoincrement())
  merchantId     Int      // Kiunganishi cha SaaS
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // models nyingine za Order zinabaki...
}

model SpecialRequest {
  id             Int      @id @default(autoincrement())
  merchantId     Int      // Kiunganishi cha SaaS
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // models nyingine za SpecialRequest zinabaki...
}
```


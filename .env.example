# ============================================================
# AI PROVIDERS - unaweza kuweka nyingi, mfumo unajaribu kwa mpangilio
# (ya kwanza ikishindwa/ikifika rate limit, inayofuata inajaribiwa kiotomatiki)
# ============================================================

# Mpangilio wa kujaribu providers (comma-separated, bila nafasi baada ya comma)
AI_PROVIDER_ORDER=gemini,groq,qwen

# --- Google Gemini (BURE - free tier) ---
# Pata key yako bure: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (BURE - free tier, kasi sana) ---
# Pata key yako bure: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Alibaba Cloud Qwen (DashScope) ---
# Pata key yako: https://modelstudio.console.alibabacloud.com
# Tumia "https://dashscope.aliyuncs.com/compatible-mode/v1" kama uko China mainland
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Jina la duka lako - AI itajitambulisha kwa jina hili
BUSINESS_NAME=Duka Langu

# Port ya server (dashboard + API)
PORT=3000

# Database (SQLite - faili moja, hakuna setup ngumu)
DATABASE_URL="file:./dev.db"

# Idadi ya messages za nyuma AI itakazosoma kama "kumbukumbu" ya mazungumzo
CONVERSATION_HISTORY_LIMIT=20

# Admin dashboard - password rahisi ya kuingia (badilisha hii!)
ADMIN_PASSWORD=change_this_password

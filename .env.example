# ============================================================
# AI PROVIDERS - unaweza kuweka nyingi, mfumo unajaribu kwa mpangilio
# (ya kwanza ikishindwa/ikifika rate limit, inayofuata inajaribiwa kiotomatiki)
# ============================================================

# Mpangilio wa kujaribu providers (comma-separated, bila nafasi baada ya comma)
AI_PROVIDER_ORDER=gemini,groq,qwen

# --- Google Gemini (BURE - free tier) ---
# Pata key yako bure: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (BURE - free tier, kasi sana) ---
# Pata key yako bure: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Alibaba Cloud Qwen (DashScope) ---
# Pata key yako: https://modelstudio.console.alibabacloud.com
# Tumia "https://dashscope.aliyuncs.com/compatible-mode/v1" kama uko China mainland
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Jina la duka lako - AI itajitambulisha kwa jina hili
BUSINESS_NAME=Duka Langu

# Port ya server (dashboard + API)
PORT=3000

# Database (SQLite - faili moja, hakuna setup ngumu)
DATABASE_URL="file:./dev.db"

# Idadi ya messages za nyuma AI itakazosoma kama "kumbukumbu" ya mazungumzo
CONVERSATION_HISTORY_LIMIT=20

# Admin dashboard - password rahisi ya kuingia (badilisha hii!)
ADMIN_PASSWORD=change_this_password

# AzamPay callback secret - weka URL hii kwenye AzamPay dashboard:
#   https://<domain>/api/billing/webhook?key=<AZAMPAY_CALLBACK_SECRET>
# Tengeneza: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AZAMPAY_CALLBACK_SECRET=

# Folda ya backups za WhatsApp sessions (NJE ya project). Default: ~/aziry-backups
BACKUP_DIR=

# ============================================================
# V2: META WHATSAPP CLOUD API (placeholders tu - usiweke siri halisi kwenye git)
# ============================================================
# Feature flags
FEATURE_CLOUD_API=false          # true = webhook ya Meta + worker vinawaka
FEATURE_EMBEDDED_SIGNUP=false    # true BAADA ya Meta kuidhinisha (Tech Provider + App Review)
FEATURE_BAILEYS=true             # njia ya zamani ya QR; zima baada ya merchants wote kuhamia
WEBHOOK_WORKER_IN_PROCESS=true   # false kama cPanel cron (scripts/drain-webhook-queue.js) pekee inafanya kazi

# Meta App (developers.facebook.com -> App -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=       # string yoyote ndefu ya nasibu; weka hiyo hiyo kwenye Meta webhook settings
META_GRAPH_API_VERSION=v23.0
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Encryption (bytes 32, base64). Tengeneza: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=            # LAZIMA kwa Cloud API - inaficha access tokens za Meta
TOKEN_ENCRYPTION_KEY_PREVIOUS=   # wakati wa kubadilisha key tu
DATA_ENCRYPTION_KEY=             # hiari - bila hii inatokana na ENCRYPTION_KEY (HKDF)

# URL ya umma ya app (inahitajika kutuma picha za bidhaa kupitia Cloud API)
APP_URL=https://example.com
# Nyuma ya cPanel/Apache proxy
TRUST_PROXY=1
